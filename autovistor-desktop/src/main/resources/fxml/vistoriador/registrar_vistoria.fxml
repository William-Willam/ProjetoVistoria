<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.william.autovistordesktop.view.vistoriador.RegistrarVistoriaController"
            prefWidth="700" prefHeight="650">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <top>
        <VBox spacing="10.0">
            <Label fx:id="labelTitulo" text="Registrar Vistoria" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Resultado geral:"/>
                <ComboBox fx:id="comboResultado"/>
            </HBox>
            <Label text="Observações gerais:"/>
            <TextArea fx:id="campoObservacoes" prefRowCount="2" wrapText="true"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <BorderPane.margin>
                <Insets top="15.0"/>
            </BorderPane.margin>
            <Label text="Checklist de itens" style="-fx-font-weight: bold;"/>
            <TableView fx:id="tabelaChecklist" prefHeight="220">
                <columns>
                    <TableColumn fx:id="colunaNomeItem" text="Item" prefWidth="200"/>
                    <TableColumn fx:id="colunaSituacao" text="Situação" prefWidth="120"/>
                    <TableColumn fx:id="colunaObservacao" text="Observação" prefWidth="330"/>
                </columns>
            </TableView>
            <HBox spacing="10.0">
                <Button fx:id="botaoAdicionarItem" text="+ Adicionar item livre"/>
                <Button fx:id="botaoRemoverItem" text="Remover item selecionado" disable="true"/>
            </HBox>


            <Label text="Fotos" style="-fx-font-weight: bold;"/>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button fx:id="botaoAdicionarFoto" text="Selecionar Fotos..."/>
                <Label fx:id="labelFotosSelecionadas" text="Nenhuma foto selecionada"/>
            </HBox>

            <Label text="Pagamento" style="-fx-font-weight: bold;"/>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Forma:"/>
                <ComboBox fx:id="comboFormaPagamento"/>
                <Label text="Valor (R$):"/>
                <TextField fx:id="campoValor" prefWidth="100"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <BorderPane.margin>
                <Insets top="15.0"/>
            </BorderPane.margin>
            <Button fx:id="botaoCancelar" text="Cancelar"/>
            <Button fx:id="botaoSalvar" text="Salvar Vistoria" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
        </HBox>
    </bottom>
</BorderPane>