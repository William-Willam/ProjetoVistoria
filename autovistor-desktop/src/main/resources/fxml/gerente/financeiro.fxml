<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.william.autovistordesktop.view.gerente.FinanceiroController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <top>
        <Label text="Boletos Pendentes" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    </top>

    <center>
        <TableView fx:id="tabelaBoletos">
            <columns>
                <TableColumn fx:id="colunaIdBoleto" text="ID Boleto" prefWidth="80"/>
                <TableColumn fx:id="colunaCodigoBarras" text="Código de Barras" prefWidth="280"/>
                <TableColumn fx:id="colunaVencimento" text="Vencimento" prefWidth="100"/>
                <TableColumn fx:id="colunaValor" text="Valor" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="15.0"/>
            </padding>
            <Button fx:id="botaoAtualizar" text="Atualizar Lista"/>
            <Button fx:id="botaoConfirmar" text="Confirmar Pagamento" disable="true"/>
        </HBox>
    </bottom>
</BorderPane>