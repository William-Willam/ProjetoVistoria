<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.william.autovistordesktop.view.gerente.GestaoFuncionariosController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <top>
        <Label text="Gestão de Funcionários" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    </top>

    <center>
        <TableView fx:id="tabelaFuncionarios">
            <columns>
                <TableColumn fx:id="colunaId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colunaNome" text="Nome" prefWidth="180"/>
                <TableColumn fx:id="colunaEmail" text="E-mail" prefWidth="200"/>
                <TableColumn fx:id="colunaMatricula" text="Matrícula" prefWidth="100"/>
                <TableColumn fx:id="colunaCargo" text="Cargo" prefWidth="120"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="15.0"/>
            </padding>
            <Button fx:id="botaoAtualizar" text="Atualizar Lista" styleClass="botao-secundario"/>
            <Button fx:id="botaoNovoFuncionario" text="Novo Funcionário" styleClass="botao-primario"/>
            <Button fx:id="botaoEditar" text="Editar" disable="true" styleClass="botao-secundario"/>
            <Button fx:id="botaoDesligar" text="Desligar" disable="true" styleClass="botao-perigo"/>
        </HBox>
    </bottom>
</BorderPane>